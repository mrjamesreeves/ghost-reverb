{{!< default}}

{{!-- Homepage (per Figma 321-106). Lead = the latest Midnight Radio
     episode as a left-bleed black cover block, with a right rail:
     the six most recent posts across sections ("Recently") and the
     signup CTA. Below: two section tiles + three app tiles.

     Recently fetches SEVEN posts (Design excluded — unlisted):
     {{#get}} can't interpolate the hero's id into a filter (hard
     rule), so zen.js drops the row duplicating the hero and trims
     the list to six. Section labels come from the first PUBLIC tag
     (primary_tag is empty when an internal tag sorts first — hard
     rule); zen.js swaps raw tag names ("Art", "favorites") for the
     nav's display labels via the data-tag attributes. --}}

{{#contentFor "title"}}{{@site.title}}{{/contentFor}}

<div class="home-lead">
  {{#get "posts" filter="tag:midnight-radio" limit="1" order="published_at desc" include="tags"}}
    {{#foreach posts}}
    {{!-- Tag classes make per-episode CSS scopes (tag-hash-mr-NN)
         work on the homepage hero too. --}}
    <a class="mr-hero mr-hero--link{{#foreach tags visibility="all"}} tag-{{slug}}{{/foreach}}" href="{{url}}">
      <div class="mr-hero-text">
        <p class="mr-hero-eyebrow">
          Midnight Radio
          {{#foreach tags visibility="internal"}}<span class="episode-number" data-ep="{{slug}}"></span>{{/foreach}}
        </p>
        <h1 class="mr-hero-title">{{title}}</h1>
      </div>
      {{#if feature_image}}
        <img class="mr-hero-art"
          srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1600w"
          sizes="(max-width: 1099px) 100vw, 50vw"
          src="{{img_url feature_image size="l"}}"
          alt="{{title}}" loading="eager">
      {{/if}}
    </a>
    {{/foreach}}
  {{/get}}

  <aside class="home-rail">
    <section class="home-recent" aria-label="Recent posts">
      <h2 class="home-recent-title">Recently</h2>
      <div class="home-recent-list" id="homeRecent">
        {{#get "posts" filter="tag:-design" limit="7" order="published_at desc" include="tags"}}
          {{#foreach posts}}
            <a class="home-recent-row" href="{{url}}">
              <span class="home-recent-post">{{title}}</span>
              <span class="home-recent-section"{{#foreach tags visibility="public" limit="1"}} data-tag="tag-{{slug}}"{{/foreach}}>{{#foreach tags visibility="public" limit="1"}}{{name}}{{/foreach}}</span>
              <span class="home-recent-date">{{date format="MMMM D"}}</span>
            </a>
          {{/foreach}}
        {{/get}}
      </div>
    </section>

    {{#unless @member}}
    <div class="home-rail-cta" aria-label="Subscribe">
      <p class="cta-title">Join Midnight Radio</p>
      <p class="cta-blurb">Notes on surviving the 21st century and a mixtape delivered &rsquo;round midnight on the 1st and 15th of the month.</p>
      <button class="cta-button" data-signup>Subscribe</button>
    </div>
    {{/unless}}
  </aside>
</div>

{{!-- Two section tiles + three app tiles. App artwork is baked into
     the images; text overlays live here. --}}
<div class="home-tiles">
  <a class="home-tile" href="{{@site.url}}/art-diary/">
    <img src="{{asset "img/home-art-diary.webp"}}" alt="" loading="lazy">
    <span class="home-tile-title">Art Diary</span>
  </a>
  <a class="home-tile" href="{{@site.url}}/favorites/">
    <img src="{{asset "img/home-favorites.webp"}}" alt="" loading="lazy">
    <span class="home-tile-title">Favorite<br>Things</span>
  </a>
</div>
<div class="home-tiles home-tiles--apps">
  <a class="home-tile home-tile--small" href="https://spite.jamesreeves.co">
    <img src="{{asset "img/home-spite.webp"}}" alt="" loading="lazy">
    <span class="home-tile-text">
      <span class="home-tile-title">Spite</span>
      <span class="home-tile-tagline">A streamlined music player.<br>No algorithms. Taste is your problem.</span>
      <span class="home-tile-platform">For iOS + Mac</span>
    </span>
  </a>
  <a class="home-tile home-tile--small" href="https://thedream.club">
    <img src="{{asset "img/home-dream-club.webp"}}" alt="" loading="lazy">
    <span class="home-tile-text">
      <span class="home-tile-title">Dream Club</span>
      <span class="home-tile-tagline">A dignified home for your dreams.</span>
      <span class="home-tile-platform">For iOS + Mac</span>
    </span>
  </a>
  <a class="home-tile home-tile--small" href="https://godisallmouth.com">
    <img src="{{asset "img/home-god.webp"}}" alt="" loading="lazy">
    <span class="home-tile-text">
      <span class="home-tile-title">God Is All Mouth</span>
      <span class="home-tile-tagline">Audio. Visual. Mystical.</span>
    </span>
  </a>
</div>
