{{!< default}}

{{!-- /about/ — the generic page treatment PLUS the "Instructions for
     Myself" post folded in. The post stays live at /instructions/
     untouched; its content renders hidden here and zen.js moves it
     into the <div data-instructions></div> HTML-card marker placed
     in the About editor (after bio, before press). Without the
     marker or JS it simply appears after the page content. --}}

{{#post}}

  <article class="post post--page" data-slug="{{slug}}">

    {{#if feature_image}}
      <figure class="post-image">
        <img
          srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1600w"
          sizes="(max-width: 960px) 100vw, 900px"
          src="{{img_url feature_image size="l"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="eager">
        {{#if feature_image_caption}}
          <figcaption class="post-image-caption">{{{feature_image_caption}}}</figcaption>
        {{/if}}
      </figure>
    {{/if}}

    <div class="post-body-col">
      {{#if @page.show_title_and_feature_image}}
        <h1 class="post-title">{{title}}</h1>
      {{/if}}
      <div class="post-content">
        {{content}}
      </div>

      {{#get "posts" filter="slug:instructions" limit="1"}}
        {{#foreach posts}}
          <div class="post-content about-instructions" id="aboutInstructions" hidden>
            {{content}}
          </div>
        {{/foreach}}
      {{/get}}
    </div>

  </article>

{{/post}}
