{{!< default}}

{{!-- /favorites/ — latest post as a full post; 3-column numbered
     list subnav below. Literal tag filter — {{#get}} can't
     interpolate. --}}

{{#contentFor "title"}}Favorite Things — {{@site.title}}{{/contentFor}}

{{#get "posts" filter="tag:favorites" limit="all" order="published_at desc" include="tags"}}
  {{#foreach posts limit="1"}}
    {{> "post-view"}}
  {{/foreach}}
  {{> "subnav-list" sectionTitle="Favorite Things" sectionUrl="/favorites/"}}
{{/get}}
