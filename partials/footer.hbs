{{!-- One-line site footer: wordmark, section links, social icons.
     Spans 90% of the viewport, max 1600px, centered. --}}

{{!-- Non-members get the full signup CTA above the footer — same
     copy/design as the hover-nav's (which stays hidden until
     discovered). Desktop: button → modal. Mobile: inline members
     form, mirroring the menu. --}}
{{#unless @member}}
<section class="signup-footer" aria-label="Subscribe">
  <p class="signup-footer-title">Join Midnight Radio</p>
  <p class="signup-footer-blurb">Notes on surviving the 21st century and a mixtape delivered &rsquo;round midnight on the 1st and 15th of the month.</p>
  <button class="site-nav-subscribe signup-footer-button" data-signup>Subscribe</button>
  <form class="signup-footer-form" data-members-form="signup">
    <input class="signup-footer-input" type="email" data-members-email placeholder="Enter your email..." required aria-label="Email address">
    <button class="signup-footer-go" type="submit">Subscribe</button>
  </form>
  <p class="signup-footer-success">Hell yeah&mdash;thank you for tuning in! Now check your inbox.</p>
</section>
{{/unless}}

<footer class="site-footer">
  <a class="wordmark wordmark--footer" href="{{@site.url}}/">James A. Reeves</a>

  {{!-- Mobile only: same burger as the header, opens the same menu. --}}
  <button class="nav-burger nav-burger--footer" aria-label="Menu" aria-expanded="false">
    <span></span><span></span>
  </button>

  <nav class="site-footer-links" aria-label="Sections">
    <a href="{{@site.url}}/radio/">Midnight Radio</a>
    <a href="{{@site.url}}/art-diary/">Art Diary</a>
    <a href="{{@site.url}}/dreams/">Dream Inventory</a>
    <a href="{{@site.url}}/spite/">Spite</a>
    <a href="{{@site.url}}/public-works/">Public Works</a>
    <a href="{{@site.url}}/favorites/">Favorite Things</a>
    <a href="{{@site.url}}/instructions/">Instructions for Myself</a>
    <a href="{{@site.url}}/about/">About</a>
    <a href="{{@site.url}}/archive/">Archive</a>
  </nav>

  <div class="site-footer-icons">
    {{!-- Ghost's native search — the #/search hash opens it. --}}
    <a href="#/search" aria-label="Search">
      <img src="{{asset "img/icon-search.svg"}}" alt="" loading="lazy">
    </a>
    <a href="https://www.jamesreeves.co/rss/" aria-label="RSS feed">
      <img src="{{asset "img/icon-rss.svg"}}" alt="" loading="lazy">
    </a>
    <a href="https://apps.apple.com/us/app/spite-music-player/id6757397964" aria-label="Spite on the App Store">
      <img src="{{asset "img/icon-app-store.svg"}}" alt="" loading="lazy">
    </a>
    <a href="https://bandcamp.com/jamesreeves" aria-label="Bandcamp">
      <img src="{{asset "img/icon-bandcamp.svg"}}" alt="" loading="lazy">
    </a>
    <a href="https://bsky.app/profile/jamesreeves.co" aria-label="Bluesky">
      <img src="{{asset "img/icon-bsky.svg"}}" alt="" loading="lazy">
    </a>
  </div>
</footer>
