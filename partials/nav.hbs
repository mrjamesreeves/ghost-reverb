{{!-- Wordmark + nav: a plain, always-visible row (Franklin Gothic
     Cond, #999 resting, black + underline on the current section —
     zen.js sets .is-active from the path or the article's tags).

     Mobile (<900px): the row hides behind the 34×20 burger; tapping
     opens the full-screen menu (same .site-nav element, restyled)
     with stacked links, inline signup form, and social icons.
     zen.js owns the toggle; scrolling locks while open. --}}

<header class="site-top" id="siteTop">
  <div class="site-top-inner">

    <a class="wordmark" id="wordmark" href="{{@site.url}}/">James A. Reeves</a>

    <button class="nav-burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span>
    </button>

    <nav class="site-nav" id="siteNav" aria-label="Site">
      <a class="site-nav-link" href="{{@site.url}}/radio/" data-tag="tag-midnight-radio">Midnight Radio</a>
      <a class="site-nav-link" href="{{@site.url}}/art-diary/" data-tag="tag-art-diary">Art Diary</a>
      <a class="site-nav-link" href="{{@site.url}}/dreams/" data-tag="tag-dreams">Dreams</a>
      <a class="site-nav-link" href="{{@site.url}}/favorites/" data-tag="tag-favorites">Favorite Things</a>
      <a class="site-nav-link" href="{{@site.url}}/public-works/" data-tag="tag-public-works">Public Works</a>
      <a class="site-nav-link" href="{{@site.url}}/notebook/" data-tag="">Notes</a>
      <a class="site-nav-link" href="{{@site.url}}/about/" data-tag="">About</a>

      {{!-- Mobile-menu-only: inline signup + social icons. --}}
      {{#unless @member}}
      <div class="site-nav-cta">
        <p class="site-nav-cta-title">Join Midnight Radio</p>
        <p class="site-nav-cta-blurb">Notes on surviving the 21st century and a mixtape delivered &rsquo;round midnight on the 1st and 15th of the month.</p>
        <form class="site-nav-signup-form" data-members-form="signup">
          <input class="site-nav-signup-input" type="email" data-members-email placeholder="Enter your email..." required aria-label="Email address">
          <button class="site-nav-signup-go" type="submit">Subscribe</button>
        </form>
        <p class="site-nav-signup-success">Hell yeah&mdash;thank you for tuning in! Now check your inbox.</p>
      </div>
      {{/unless}}

      <div class="site-nav-icons">
        <a href="#/search" aria-label="Search"><img src="{{asset "img/icon-search.svg"}}" alt="" loading="lazy"></a>
        <a href="{{@site.url}}/rss/" aria-label="RSS feed"><img src="{{asset "img/icon-rss.svg"}}" alt="" loading="lazy"></a>
        <a href="https://apps.apple.com/us/app/spite-music-player/id6757397964" aria-label="Spite on the App Store"><img src="{{asset "img/icon-app-store.svg"}}" alt="" loading="lazy"></a>
        <a href="https://midnightradio.bandcamp.com" aria-label="Bandcamp"><img src="{{asset "img/icon-bandcamp.svg"}}" alt="" loading="lazy"></a>
        <a href="https://bsky.app/profile/jamesreeves.co" aria-label="Bluesky"><img src="{{asset "img/icon-bsky.svg"}}" alt="" loading="lazy"></a>
      </div>
    </nav>

  </div>
</header>
