{{!-- One thumbnail dial entry — expects a post context. The tile is
     the post's feature image; the name chip appears on hover/focus
     and on the current entry (CSS). --}}
<a href="{{url}}" data-slug="{{slug}}" class="dial-thumb" aria-label="{{title}}">
  {{#if feature_image}}
    <img src="{{img_url feature_image size="xxs"}}" srcset="{{img_url feature_image size="xxs"}} 150w, {{img_url feature_image size="xs"}} 300w" sizes="80px" alt="" loading="lazy">
  {{else}}
    <span class="dial-thumb-empty"></span>
  {{/if}}
  <span class="dial-thumb-name">{{title}}</span>
</a>
